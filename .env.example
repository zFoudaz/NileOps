# NileOps Docker Environment Configuration
# To use: copy this file to .env
# Windows PowerShell: Copy-Item .env.example .env
# Linux / macOS:      cp .env.example .env

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nileops
POSTGRES_PORT=5433

# Frontend Port
FRONTEND_PORT=5173

# Backend & Security Configuration
SECRET_KEY=6a879336edb20ad0a6030f29f0fb25fe62b50120efc7eede3070a95d345295ea
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ollama AI Vision Model (Host machine reached from Docker)
# For Docker:  http://host.docker.internal:11434
# For Local:   http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b

# LLM OCR & Parser Configuration (ollama | openai)
OCR_PROVIDER=ollama
OCR_MODEL=qwen3.5:4b
OCR_BASE_URL=http://host.docker.internal:11434

PARSER_PROVIDER=ollama
PARSER_MODEL=qwen3.5:4b
PARSER_BASE_URL=http://host.docker.internal:11434

# Optional: OpenAI or OpenAI-compatible endpoints (SovereignEG, Groq, Together AI, OpenRouter, DeepSeek, vLLM)
# When using an OpenAI-compatible provider:
# 1. Set OCR_PROVIDER=openai and/or PARSER_PROVIDER=openai
# 2. Set your model name in OCR_MODEL / PARSER_MODEL
# 3. Provide your API key and base_url below:
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Default Seeded Employee Account
DEFAULT_EMPLOYEE_NAME=أحمد فؤاد
DEFAULT_EMPLOYEE_EMAIL=employee@nileops.com
DEFAULT_EMPLOYEE_PASSWORD=EmployeePass123!
